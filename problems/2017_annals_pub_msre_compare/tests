[Tests]
  # Replaced mesh files with coarser mesh in moltres/tests/coupled to reduce
  # test run time and memory usage. The mesh files have slightly different
  # dimensions but share the same block and boundary IDs/names.
  [4group]
    type = RunApp
    input = 4group.i
    check_input = True
    cli_args = 'Mesh/file=../../tests/coupled/2d_lattice_structured.msh'
    capabilities = 'method=opt'
    min_slots = 2 # 393 MB per slot observed during https://civet.inl.gov/job/4311210/ during step Test deprecated. Usage is over or within 100 MB of the total memory limit based on a 400 MB per slot limit.
  []
  [4group_eigen]
    type = RunApp
    input = 4group_eigen.i
    check_input = True
    cli_args = 'Mesh/file=../../tests/coupled/2d_lattice_structured.msh'
    capabilities = 'method=opt'
  []
  [2group]
    type = RunApp
    input = 2group.i
    check_input = True
    cli_args = 'Mesh/file=../../tests/coupled/2d_lattice_structured.msh'
    capabilities = 'method=opt'
  []
  [2group_eigen]
    type = RunApp
    input = 2group_eigen.i
    check_input = True
    cli_args = 'Mesh/file=../../tests/coupled/2d_lattice_structured.msh'
    capabilities = 'method=opt'
  []
  [auto_diff_rho]
    type = RunApp
    input = auto_diff_rho.i
    check_input = True
    cli_args = 'Mesh/file=../../tests/coupled/2d_lattice_structured.msh'
    capabilities = 'method=opt'
    min_slots = 2 # 668 MB per slot observed during https://civet.inl.gov/job/4311210/ during step Test deprecated. Usage is over or within 100 MB of the total memory limit based on a 400 MB per slot limit.
  []
[]
